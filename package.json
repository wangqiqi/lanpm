    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
