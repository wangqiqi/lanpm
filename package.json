{
  "name": "lanpm",
  "version": "1.0.0-rc.56",
  "description": "分布式局域网协作客户端 — Electron",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-native-deps.mjs",
    "dev": "node scripts/dev-run.mjs",
    "dev:web": "node scripts/dev-run.mjs --web",
    "prebuild": "node scripts/ensure-native-deps.mjs",
    "build": "electron-vite build",
    "prepreview": "node scripts/ensure-native-deps.mjs",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "verify:preview-extensions": "node --experimental-strip-types tests/static/verify-preview-extensions.ts",
    "verify:format-file-type": "node --experimental-strip-types tests/static/verify-format-file-type.ts",
    "verify:shared": "node --experimental-strip-types tests/runners/verify-shared.ts",
    "verify:p0": "node --experimental-strip-types tests/runners/verify-p0.ts",
    "verify:ipc-contract": "node --experimental-strip-types tests/static/verify-ipc-contract.ts",
    "verify:i18n-keys": "node --experimental-strip-types tests/static/verify-i18n-keys.ts",
    "verify:docs-links": "node --experimental-strip-types tests/static/verify-docs-links.ts",
    "verify:docs-code": "node --experimental-strip-types tests/static/verify-docs-code.ts",
    "verify:rc-reality": "node --experimental-strip-types tests/static/verify-rc-reality.ts",
    "verify:router-views": "node --experimental-strip-types tests/static/verify-router-views.ts",
    "verify:stub-parity": "node --experimental-strip-types tests/static/verify-stub-parity.ts",
    "verify:sync-handlers": "node --experimental-strip-types tests/static/verify-sync-handlers.ts",
    "verify:schema-repo": "node --experimental-strip-types tests/static/verify-schema-repo.ts",
    "verify:schema-fk": "node --experimental-strip-types tests/static/verify-schema-fk.ts",
    "verify:dual-stub": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-dual-stub.ts",
    "verify:peer-registry": "node --experimental-strip-types tests/integration/verify-peer-registry.ts",
    "verify:storage": "node scripts/run-electron-node.mjs tests/integration/verify-storage.mjs",
    "verify:suffix": "node --experimental-strip-types tests/static/verify-suffix.ts",
    "verify:network-stub": "node --experimental-strip-types tests/integration/verify-network-stub.ts",
    "verify:network-manual": "node --experimental-strip-types tests/static/verify-network-manual.ts",
    "verify:offline-sync": "node --experimental-strip-types tests/static/verify-offline-sync.ts",
    "verify:offline-sync-integration": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-offline-sync-integration.ts",
    "verify:file-concurrency": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-file-concurrency.ts",
    "verify:coverage": "node --experimental-strip-types tests/runners/verify-coverage.ts",
    "verify:task-sync": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-task-sync.ts",
    "verify:file-sync": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-file-sync.ts",
    "verify:i18n-en": "node --experimental-strip-types tests/static/verify-i18n-en.ts",
    "verify:network-multicast": "node --experimental-strip-types tests/static/verify-network-multicast.ts",
    "verify:m0": "npm run verify:storage && npm run verify:suffix && npm run verify:network-stub && npm run verify:peer-registry",
    "verify:routes": "node --experimental-strip-types tests/static/verify-routes.ts",
    "verify:topbar": "node --experimental-strip-types tests/static/verify-topbar.ts",
    "verify:profile-panel": "node --experimental-strip-types tests/static/verify-profile-panel.ts",
    "verify:discover": "node --experimental-strip-types tests/static/verify-discover.ts",
    "verify:m1": "npm run verify:routes && npm run verify:topbar && npm run verify:profile-panel && npm run verify:discover",
    "verify:chat": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-chat.ts",
    "verify:mentions": "node --experimental-strip-types tests/static/verify-mentions.ts",
    "verify:dm": "node --experimental-strip-types tests/static/verify-dm.ts",
    "verify:presence": "node --experimental-strip-types tests/static/verify-presence.ts",
    "verify:read-receipt": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-read-receipt.ts",
    "verify:real-subscribe-all": "node --experimental-strip-types tests/static/verify-real-subscribe-all.ts",
    "verify:m2-integration": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-m2-integration.ts",
    "verify:m2": "npm run verify:mentions && npm run verify:dm && npm run verify:presence && npm run verify:read-receipt && npm run verify:real-subscribe-all && npm run verify:m2-integration && npm run verify:chat && npm run verify:dual-stub",
    "verify:m3": "node --experimental-strip-types tests/static/verify-m3.ts",
    "verify:m4": "node --experimental-strip-types tests/static/verify-m4.ts",
    "verify:m5": "node --experimental-strip-types tests/static/verify-m5.ts",
    "verify:m6": "node --experimental-strip-types tests/integration/verify-m6.ts",
    "verify:search": "node --experimental-strip-types tests/static/verify-search.ts",
    "verify:visual": "node --experimental-strip-types tests/static/verify-visual.ts",
    "verify:electron-smoke": "node --experimental-strip-types tests/integration/verify-electron-smoke.ts",
    "verify:visual-screenshots": "node --experimental-strip-types tests/integration/verify-visual-screenshots.ts",
    "verify:project": "node --experimental-strip-types tests/runners/verify-project.ts",
    "verify:release-gate": "node --experimental-strip-types tests/runners/verify-release-gate.ts",
    "verify:m7-acceptance": "node --experimental-strip-types tests/static/verify-m7-acceptance.ts",
    "verify:m7-stability": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-m7-stability.ts",
    "verify:m7-perf": "node scripts/run-electron-node.mjs --experimental-strip-types tests/integration/verify-m7-perf.ts",
    "verify:m7": "node scripts/ensure-native-deps.mjs && node --experimental-strip-types tests/runners/verify-m7.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "ensure:native": "node scripts/ensure-native-deps.mjs",
    "rebuild:native": "node scripts/ensure-native-deps.mjs --force",
    "postinstall": "node scripts/ensure-native-deps.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^5.26.0",
    "better-sqlite3": "^12.10.0",
    "electron-screenshots": "^0.6.1",
    "gantt-task-react": "^0.3.9",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^8.0.14",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
