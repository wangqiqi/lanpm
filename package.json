{
  "name": "lanpm",
  "version": "1.0.0-rc.23",
  "description": "分布式局域网协作客户端 — Electron",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-native-deps.mjs",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:web": "env -u ELECTRON_RUN_AS_NODE LANPM_BROWSER_DEV=1 electron-vite dev --rendererOnly",
    "prebuild": "node scripts/ensure-native-deps.mjs",
    "build": "electron-vite build",
    "prepreview": "node scripts/ensure-native-deps.mjs",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "verify:storage": "node scripts/run-electron-node.mjs scripts/verify-storage.mjs",
    "verify:suffix": "node --experimental-strip-types scripts/verify-suffix.ts",
    "verify:network-stub": "LANPM_NETWORK=stub node --experimental-strip-types scripts/verify-network-stub.ts",
    "verify:network-manual": "node --experimental-strip-types scripts/verify-network-manual.ts",
    "verify:offline-sync": "node --experimental-strip-types scripts/verify-offline-sync.ts",
    "verify:task-sync": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-task-sync.ts",
    "verify:file-sync": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-file-sync.ts",
    "verify:i18n-en": "node --experimental-strip-types scripts/verify-i18n-en.ts",
    "verify:network-multicast": "node --experimental-strip-types scripts/verify-network-multicast.ts",
    "verify:m0": "npm run verify:storage && npm run verify:suffix && npm run verify:network-stub",
    "verify:routes": "node --experimental-strip-types scripts/verify-routes.ts",
    "verify:topbar": "node --experimental-strip-types scripts/verify-topbar.ts",
    "verify:m1": "npm run verify:routes && npm run verify:topbar",
    "verify:chat": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-chat.ts",
    "verify:mentions": "node --experimental-strip-types scripts/verify-mentions.ts",
    "verify:dm": "node --experimental-strip-types scripts/verify-dm.ts",
    "verify:presence": "node --experimental-strip-types scripts/verify-presence.ts",
    "verify:read-receipt": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-read-receipt.ts",
    "verify:m2-integration": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-m2-integration.ts",
    "verify:m2": "npm run verify:mentions && npm run verify:dm && npm run verify:presence && npm run verify:read-receipt && npm run verify:m2-integration && npm run verify:chat",
    "verify:m3": "node --experimental-strip-types scripts/verify-m3.ts",
    "verify:m4": "node --experimental-strip-types scripts/verify-m4.ts",
    "verify:m5": "node --experimental-strip-types scripts/verify-m5.ts",
    "verify:m6": "node --experimental-strip-types scripts/verify-m6.ts",
    "verify:search": "node --experimental-strip-types scripts/verify-search.ts",
    "verify:visual": "node --experimental-strip-types scripts/verify-visual.ts",
    "verify:project": "node --experimental-strip-types scripts/verify-project.ts",
    "verify:m7-acceptance": "node --experimental-strip-types scripts/verify-m7-acceptance.ts",
    "verify:m7-stability": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-m7-stability.ts",
    "verify:m7-perf": "node scripts/run-electron-node.mjs --experimental-strip-types scripts/verify-m7-perf.ts",
    "verify:m7": "node scripts/ensure-native-deps.mjs && node --experimental-strip-types scripts/verify-m7.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "ensure:native": "node scripts/ensure-native-deps.mjs",
    "rebuild:native": "node scripts/ensure-native-deps.mjs --force",
    "postinstall": "node scripts/ensure-native-deps.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^5.26.0",
    "better-sqlite3": "^12.10.0",
    "electron-screenshots": "^0.6.1",
    "gantt-task-react": "^0.3.9",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^8.0.14"
  }
}
