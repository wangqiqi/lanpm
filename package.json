{
  "name": "lanpm",
  "version": "0.6.1-m2",
  "description": "分布式局域网协作客户端 — Electron",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:suffix": "node --experimental-strip-types scripts/verify-suffix.ts",
    "verify:network-stub": "node --experimental-strip-types scripts/verify-network-stub.ts",
    "verify:m0": "npm run verify:storage && npm run verify:suffix && npm run verify:network-stub",
    "verify:routes": "node --experimental-strip-types scripts/verify-routes.ts",
    "verify:topbar": "node --experimental-strip-types scripts/verify-topbar.ts",
    "verify:m1": "npm run verify:routes && npm run verify:topbar",
    "verify:chat": "node --experimental-strip-types scripts/verify-chat.ts",
    "verify:m2": "npm run verify:chat",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.26.0",
    "better-sqlite3": "^11.10.0",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^5.4.19"
  }
}
