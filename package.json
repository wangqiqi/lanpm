{
  "name": "lanpm",
  "version": "1.0.0-rc.5",
  "description": "分布式局域网协作客户端 — Electron",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:suffix": "node --experimental-strip-types scripts/verify-suffix.ts",
    "verify:network-stub": "LANPM_NETWORK=stub node --experimental-strip-types scripts/verify-network-stub.ts",
    "verify:m0": "npm run verify:storage && npm run verify:suffix && npm run verify:network-stub",
    "verify:routes": "node --experimental-strip-types scripts/verify-routes.ts",
    "verify:topbar": "node --experimental-strip-types scripts/verify-topbar.ts",
    "verify:m1": "npm run verify:routes && npm run verify:topbar",
    "verify:chat": "node --experimental-strip-types scripts/verify-chat.ts",
    "verify:mentions": "node --experimental-strip-types scripts/verify-mentions.ts",
    "verify:dm": "node --experimental-strip-types scripts/verify-dm.ts",
    "verify:presence": "node --experimental-strip-types scripts/verify-presence.ts",
    "verify:read-receipt": "node --experimental-strip-types scripts/verify-read-receipt.ts",
    "verify:m2-integration": "node --experimental-strip-types scripts/verify-m2-integration.ts",
    "verify:m2": "npm run verify:mentions && npm run verify:dm && npm run verify:presence && npm run verify:read-receipt && npm run verify:m2-integration && npm run verify:chat",
    "verify:m3": "node --experimental-strip-types scripts/verify-m3.ts",
    "verify:m4": "node --experimental-strip-types scripts/verify-m4.ts",
    "verify:m5": "node --experimental-strip-types scripts/verify-m5.ts",
    "verify:m6": "node --experimental-strip-types scripts/verify-m6.ts",
    "verify:search": "node --experimental-strip-types scripts/verify-search.ts",
    "verify:visual": "node --experimental-strip-types scripts/verify-visual.ts",
    "verify:project": "node --experimental-strip-types scripts/verify-project.ts",
    "verify:m7-acceptance": "node --experimental-strip-types scripts/verify-m7-acceptance.ts",
    "verify:m7-stability": "node --experimental-strip-types scripts/verify-m7-stability.ts",
    "verify:m7-perf": "node --experimental-strip-types scripts/verify-m7-perf.ts",
    "verify:m7": "npm run rebuild:verify && node --experimental-strip-types scripts/verify-m7.ts && npm run rebuild:native",
    "build:icons": "node scripts/build-icons.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "rebuild:verify": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^5.26.0",
    "better-sqlite3": "^11.10.0",
    "gantt-task-react": "^0.3.9",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^5.4.19"
  }
}
