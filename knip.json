{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/src/bootstrap.tsx",
    "src/cli/main.ts",
    "scripts/lanpm.mjs",
    "scripts/onekey-preflight.mjs",
    "tests/static/verify-*.ts",
    "tests/runners/verify-*.ts",
    "tests/integration/verify-*.ts",
    "tests/e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/**/*.{mjs,js,ts}"],
  "ignore": ["out/**", "dist/**", "node_modules/**"],
  "ignoreDependencies": ["@electron/rebuild", "@resvg/resvg-js"]
}
